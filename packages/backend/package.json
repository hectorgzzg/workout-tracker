{
  "name": "@workout-tracker/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --watch src/server.js",
    "start": "node --env-file-if-exists=../../.env src/server.js",
    "db:migrate": "node --env-file-if-exists=../../.env src/persistence/cli.js migrate",
    "db:seed": "node --env-file-if-exists=../../.env src/persistence/cli.js seed",
    "auth:bootstrap-admin": "node --env-file-if-exists=../../.env src/persistence/cli.js bootstrap-admin",
    "test": "npm run test --workspace=workout-tracker -- --selectProjects backend"
  },
  "dependencies": {
    "csv-parse": "^7.0.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "supertest": "^7.1.4"
  }
}
