{
  "name": "workout-tracker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "packageManager": "npm@11.6.1",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --run dev:servers",
    "dev:servers": "concurrently --kill-others -n backend,frontend -c green,blue \"npm run dev --workspace=@workout-tracker/backend\" \"wait-on http://127.0.0.1:${PORT:-3000}/health && npm run dev --workspace=@workout-tracker/frontend\"",
    "build": "npm run build --workspace=@workout-tracker/frontend",
    "test": "node --env-file-if-exists=.env.test --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "test:watch": "npm run test -- --watch",
    "test:backend": "npm run test -- --selectProjects backend",
    "test:frontend": "npm run test -- --selectProjects frontend",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write \"packages/**/*.{js,json,vue}\" \"e2e/**/*.js\" \"*.json\" \"*.js\" \"*.cjs\" README.md",
    "format:check": "prettier --check \"packages/**/*.{js,json,vue}\" \"e2e/**/*.js\" \"*.json\" \"*.js\" \"*.cjs\" README.md",
    "start:backend": "npm run start --workspace=@workout-tracker/backend",
    "start:frontend": "npm run dev --workspace=@workout-tracker/frontend"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.64.1",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.6.2",
    "wait-on": "^8.0.5"
  }
}
